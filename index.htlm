<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <title>Coleta de Dados</title>
</head>
<body>

    <script>
// Processamento dos dados para gerar o crachá virtual
        const nome = prompt("Digite seu nome:");
        const sobrenome = prompt("Digite seu sobrenome:");
        const anoNascimento = Number(prompt("Digite seu ano de nascimento:"));

        const alunoAtivo = confirm("É aluno ativo da instituição?");

        const idade = 2026 - anoNascimento;
        const sobrenomeMaiusculo = sobrenome.toUpperCase();
        const quantidadeLetras = nome.length;

        console.log("CRACHÁ VIRTUAL: " + sobrenomeMaiusculo + ", " + nome);
        console.log("Idade estimada: " + idade + " anos.");
        console.log("O seu primeiro nome tem " + quantidadeLetras + " letras.");
        console.log("Estatuto de aluno ativo: " + alunoAtivo);
    </script>

</body>
</html>
